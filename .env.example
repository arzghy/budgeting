# MONGODB CONFIGURATION (MongoDB Compass / Atlas)
MONGODB_URI=mongodb://localhost:27017/mibudge

# NEXTAUTH AUTHENTICATION SECRET & URL
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# GOOGLE OAUTH CREDENTIALS (Opsional jika login Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CLOUDINARY CONFIGURATION (Dapatkan gratis di https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
